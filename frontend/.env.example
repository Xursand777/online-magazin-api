# ─────────────────────────────────────────────────────────────────────────────
# frontend/.env.example — Frontend muhit o'zgaruvchilari shabloni
#
# Ishlatish:
#   Development:  cp .env.example .env.local     # git'ga qo'shilmaydi
#   Production:   cp .env.example .env.production # yoki hosting env vars
#
# DIQQAT: .env va .env.local fayllarini HECH QACHON git'ga qo'shmang!
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend API manzili ───────────────────────────────────────────────────────
# Development (default — o'zgartirishni shart emas):
VITE_API_URL=http://127.0.0.1:8000/api

# Production (to'g'ri domen bilan almashtiring):
# VITE_API_URL=https://api.yourdomain.com/api
