# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Muhit o'zgaruvchilari shabloni
# Ishlatish: bu faylni nusxalab .env deb nomlang va qiymatlarni to'ldiring
#   cp .env.example .env
# DIQQAT: .env faylini HECH QACHON git'ga qo'shmang!
# ─────────────────────────────────────────────────────────────────────────────

# ── Django Core ───────────────────────────────────────────────────────────────
# Yangi kalit generatsiya:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-super-secret-key-here

# Development: True | Production: False
DJANGO_DEBUG=False

# Vergul bilan ajratilgan domenlar ro'yxati
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ── Admin Panel URL (Xavfsizlik) ───────────────────────────────────────────────
# Default /admin/ — brute-force/skanerlardan himoya uchun o'zgartiring.
# Misol: DJANGO_ADMIN_URL=xufiya-panel-7k2m
# Keyin: https://yourdomain.com/xufiya-panel-7k2m/
DJANGO_ADMIN_URL=admin

# ── Backup Super_admin (Lockout recovery) ─────────────────────────────────────
# Birinchi super_admin qulflanib qolsa, shu telefon orqali tiklash mumkin.
# Yaratish:  python manage.py create_backup_superuser
# Default:   +998941126777 (Bozor loyihasi backup admin'i)
BACKUP_SUPERUSER_PHONE=+998941126777

# ── CORS ──────────────────────────────────────────────────────────────────────
# Faqat frontend joylashgan domenlar (https bilan)
# Vercel'da: https://your-app.vercel.app,https://your-custom-domain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ── HTTPS ─────────────────────────────────────────────────────────────────────
# Nginx/Caddy orqali HTTPS ishlatsangiz True
# To'g'ridan-to'g'ri HTTP ishlatsangiz False
SECURE_SSL_REDIRECT=True

# ── Ma'lumotlar Bazasi ─────────────────────────────────────────────────────────
# Development (default): SQLite — hech narsa o'zgartirmang
# DATABASE_URL o'rnatilmasa, SQLite ishlatiladi: backend/db.sqlite3
#
# Production — PostgreSQL:
#   PostgreSQL o'rnatish: sudo apt install postgresql postgresql-contrib
#   Foydalanuvchi va baza yaratish:
#     sudo -u postgres psql
#     CREATE USER bozor_user WITH PASSWORD 'strong_password';
#     CREATE DATABASE bozor_db OWNER bozor_user;
#
# DATABASE_URL formatlari:
#   Lokal PostgreSQL:   postgresql://bozor_user:strong_password@localhost:5432/bozor_db
#   Docker Compose:     postgresql://bozor_user:strong_password@postgres:5432/bozor_db
#   Railway:            Railway avtomatik beradi — Variables > DATABASE_URL ni ko'chiring
DATABASE_URL=postgresql://bozor_user:strong_password@localhost:5432/bozor_db

# ── CDN — Rasm va Fayl Xizmati (object storage) ───────────────────────────────
# Qiymatlar:
#   'local'      — disk (faqat development; PRODUCTION uchun YARAMAYDI — ephemeral)
#   'r2'         — Cloudflare R2 (TAVSIYA: doimiy, egress bepul, O'zbekistonда ishonchli)
#   'b2'         — Backblaze B2
#   'cloudinary' — Cloudinary (O'zbekistonда blok bo'lishi mumkin)
#
# ⭐ MUHIM: object storage SERVERDAN MUSTAQIL. CDN_PROVIDER=r2 bo'lsa, rasmlar
# R2'da turadi — serverni Render'dan Hetzner'ga (yoki boshqa joyga) ko'chirsangiz
# ham rasmlar TEGMAYDI. Yangi serverda BIR XIL R2_* env'larni o'rnatasiz, tamom.
CDN_PROVIDER=r2

# ── Cloudflare R2 (CDN_PROVIDER=r2 bo'lsa majburiy) ──
# 1) https://dash.cloudflare.com → R2 → Create bucket (masalan: bozor-media)
# 2) R2 → Manage API Tokens → Create API Token (Object Read & Write)
# 3) Account ID — R2 sahifasining o'ng tomonida
# 4) Public ko'rinish: bucket → Settings → Public access → custom domen ulang
#    (masalan cdn.bozor.uz) — bu Cloudflare CDN keshini ham beradi.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=bozor-media
R2_PUBLIC_DOMAIN=cdn.yourdomain.com

# ── Cloudinary (faqat CDN_PROVIDER=cloudinary bo'lsa) ──
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# ── Kesh — Redis ──────────────────────────────────────────────────────────────
# OTP va rate limiting uchun. Production'da MAJBURIY.
# Redis o'rnatish: sudo apt install redis-server
# Lokal (parolsiz):    redis://127.0.0.1:6379/1
# Parolli:             redis://:mypassword@127.0.0.1:6379/1
# Docker Compose:      redis://redis:6379/1
# Railway Redis:       Railway avtomatik beradi — Variables > REDIS_URL ni ko'chiring
# Upstash (bepul):     https://upstash.com — rediss://default:token@host:port
REDIS_URL=redis://127.0.0.1:6379/1

# ── SMS — Eskiz.uz ────────────────────────────────────────────────────────────
ESKIZ_EMAIL=your@email.com
ESKIZ_PASSWORD=your-eskiz-password
ESKIZ_SENDER=4546

# Balans nazorati — past bo'lganda Telegram alert (Phase 0.5 bilan):
#   WARNING:  to'ldirish vaqti keldi, lekin shoshilinch emas
#   CRITICAL: DARHOL to'ldiring, aks holda OTP login uziladi
# Default'lar: 50 UZS/SMS hisobida (1000 SMS / 200 SMS)
# Sizning operatorga qarab 40-60 UZS oralig'ida o'zgartirish mumkin.
ESKIZ_BALANCE_WARNING_THRESHOLD=50000
ESKIZ_BALANCE_CRITICAL_THRESHOLD=10000
ESKIZ_PRICE_PER_SMS=50

# ── Backblaze B2 — DB Backup ──────────────────────────────────────────────────
# Kunlik DB backup'lar ALOHIDA bucket'ga yuklanadi (media bucket'dan farqli):
#   • bozor-media-cdn    — public-read, mahsulot rasmlari
#   • bozor-backups      — PRIVATE, DB dump'lari (PII bor!)
#
# SOZLASH (B2'da):
#   1. https://www.backblaze.com/b2/sign-up.html — bepul hisob
#   2. Buckets → Create a Bucket
#        Name:        bozor-backups (yoki sizning loyiha nomi + "-backups")
#        Files:       PRIVATE — muhim! Public bo'lsa har kim DB'ni yuklab oladi
#        Encryption:  SSE-B2 (Enable server-side encryption)
#        Lifecycle:   "Keep all versions of the file" (cleanup biz qilamiz)
#   3. App Keys → Add a New Application Key
#        Allow access to Bucket(s): bozor-backups (FAQAT shu bucket)
#        Type of Access: Read and Write
#        Capabilities: listBuckets, listFiles, readFiles, writeFiles, deleteFiles
#   4. Yaratilgan keyId va applicationKey ni quyiga yozish
#
# B2_KEY_ID va B2_APPLICATION_KEY media uchun mavjud bo'lsa ham, BACKUP uchun
# ALOHIDA key tavsiya etiladi (capability scope cheklash uchun).
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_BACKUPS=bozor-backups
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004

# Backup retention: shu kun'dan eski backup'lar avtomat o'chiriladi.
# Lekin har doim oxirgi 7 ta backup saqlab qolinadi (xatolik bo'lsa zaxira).
BACKUP_RETENTION_DAYS=30

# ── Telegram — Admin Alert Bot ────────────────────────────────────────────────
# Server xatolari, balans ogohlantirishlari, kam stock va boshqa kritik
# voqealar Telegram orqali admin'ga yetkaziladi.
#
# SOZLASH (3 daqiqada):
#   1. Telegram'da @BotFather'ga /newbot yuboring
#   2. Bot nomini (Bozor Alert) va username'ni (bozor_alert_bot) kiriting
#   3. Berilgan tokenni quyiga yozing:
TELEGRAM_BOT_TOKEN=
#
#   4. Telegram'da yangi botingizni toping va /start bosing
#      (Yoki guruhga qo'shing va botni admin qiling)
#   5. Brauzerda oching (TOKEN ni almashtiring):
#      https://api.telegram.org/bot<TOKEN>/getUpdates
#   6. Javobda "chat":{"id":12345678} qismdan id ni oling
#      (Guruh bo'lsa manfiy bo'ladi: -100123456789)
TELEGRAM_ADMIN_CHAT_ID=
#
#   7. Tekshirish:
#      python manage.py test_telegram
#      Telegram'da 4 ta test xabar paydo bo'lishi kerak

# ── Sentry — Xato kuzatish (production) ───────────────────────────────────────
# 1. https://sentry.io da bepul hisob ochish (5,000 event/oy bepul)
# 2. New Project → Platform: Django → DSN ni nusxalash
# 3. DSN ni shu yerga joylashtirish
#
# DEBUG=True bo'lsa Sentry o'chiriladi (lokal xato'lar uchun shart emas).
# Bo'sh qoldirilsa — Sentry umuman ishlamaydi (xato'lar faqat log faylda).
SENTRY_DSN=

# Optional: deploy paytida release identifier
# CI/CD pipeline'da qo'shing: GIT_COMMIT_SHA=$(git rev-parse HEAD)
# GIT_COMMIT_SHA=

# ── Rate Limit Alert (Phase 1.7) ──────────────────────────────────────────────
# Daqiqada shu sondan ko'p 429 javob bo'lsa, Telegram'ga DDoS shubhasi alert.
# Default 100 — kichik biznes uchun.
# Sotuv-sale paytlarida legit traffic ham 429 olishi mumkin — 200-500 ga oshirish mumkin.
RATE_LIMIT_ALERT_THRESHOLD=100

# ── API Hujjatlari (Swagger) ──────────────────────────────────────────────────
# Production'da Swagger'ni yopish tavsiya etiladi (default: False debug'da emas)
# Kerak bo'lsa True ga qo'ying (masalan, beta test davri)
# ENABLE_API_DOCS=False
