# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Muhit o'zgaruvchilari shabloni
# Ishlatish: bu faylni nusxalab .env deb nomlang va qiymatlarni to'ldiring
#   cp .env.example .env
# DIQQAT: .env faylini HECH QACHON git'ga qo'shmang!
# ─────────────────────────────────────────────────────────────────────────────

# ── Django Core ───────────────────────────────────────────────────────────────
# Yangi kalit generatsiya:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-super-secret-key-here

# Development: True | Production: False
DJANGO_DEBUG=False

# Vergul bilan ajratilgan domenlar ro'yxati
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ── Admin Panel URL (Xavfsizlik) ───────────────────────────────────────────────
# Default /admin/ — brute-force/skanerlardan himoya uchun o'zgartiring.
# Misol: DJANGO_ADMIN_URL=xufiya-panel-7k2m
# Keyin: https://yourdomain.com/xufiya-panel-7k2m/
DJANGO_ADMIN_URL=admin

# ── CORS ──────────────────────────────────────────────────────────────────────
# Faqat frontend joylashgan domenlar (https bilan)
# Vercel'da: https://your-app.vercel.app,https://your-custom-domain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ── HTTPS ─────────────────────────────────────────────────────────────────────
# Nginx/Caddy orqali HTTPS ishlatsangiz True
# To'g'ridan-to'g'ri HTTP ishlatsangiz False
SECURE_SSL_REDIRECT=True

# ── Ma'lumotlar Bazasi ─────────────────────────────────────────────────────────
# Development (default): SQLite — hech narsa o'zgartirmang
# DATABASE_URL o'rnatilmasa, SQLite ishlatiladi: backend/db.sqlite3
#
# Production — PostgreSQL:
#   PostgreSQL o'rnatish: sudo apt install postgresql postgresql-contrib
#   Foydalanuvchi va baza yaratish:
#     sudo -u postgres psql
#     CREATE USER bozor_user WITH PASSWORD 'strong_password';
#     CREATE DATABASE bozor_db OWNER bozor_user;
#
# DATABASE_URL formatlari:
#   Lokal PostgreSQL:   postgresql://bozor_user:strong_password@localhost:5432/bozor_db
#   Docker Compose:     postgresql://bozor_user:strong_password@postgres:5432/bozor_db
#   Railway:            Railway avtomatik beradi — Variables > DATABASE_URL ni ko'chiring
DATABASE_URL=postgresql://bozor_user:strong_password@localhost:5432/bozor_db

# ── CDN — Rasm va Fayl Xizmati ────────────────────────────────────────────────
# Qiymatlar: 'local' (disk, development) | 'cloudinary' (CDN, production)
CDN_PROVIDER=cloudinary

# Cloudinary sozlamalari (CDN_PROVIDER=cloudinary bo'lsa majburiy)
# Hisob ochish: https://cloudinary.com/users/register/free
# Dashboard > Settings > API Keys dan oling
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Kesh — Redis ──────────────────────────────────────────────────────────────
# OTP va rate limiting uchun. Production'da MAJBURIY.
# Redis o'rnatish: sudo apt install redis-server
# Lokal (parolsiz):    redis://127.0.0.1:6379/1
# Parolli:             redis://:mypassword@127.0.0.1:6379/1
# Docker Compose:      redis://redis:6379/1
# Railway Redis:       Railway avtomatik beradi — Variables > REDIS_URL ni ko'chiring
# Upstash (bepul):     https://upstash.com — rediss://default:token@host:port
REDIS_URL=redis://127.0.0.1:6379/1

# ── SMS — Eskiz.uz ────────────────────────────────────────────────────────────
ESKIZ_EMAIL=your@email.com
ESKIZ_PASSWORD=your-eskiz-password
ESKIZ_SENDER=4546

# ── API Hujjatlari (Swagger) ──────────────────────────────────────────────────
# Production'da Swagger'ni yopish tavsiya etiladi (default: False debug'da emas)
# Kerak bo'lsa True ga qo'ying (masalan, beta test davri)
# ENABLE_API_DOCS=False
