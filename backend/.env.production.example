# ═══════════════════════════════════════════════════════════════════════════
#  Bozor — Production Environment File
# ═══════════════════════════════════════════════════════════════════════════
#
# ISHLATISH:
#   1. Nusxalash:    cp .env.production.example .env
#   2. Hamma "<TODO>" qiymatlarini to'ldiring
#   3. Tasdiqlash:   python manage.py check_deployment
#   4. Deploy
#
# DIQQAT:
#   • Bu fayl shablon — .env'ni HECH QACHON git'ga commit qilmang
#   • Render Dashboard'da hamma "<TODO>" larni env vars'ga qo'shing
#   • Parolni 1Password/Bitwarden'da saqlang
#   • Har env'da [REQUIRED] / [RECOMMENDED] / [OPTIONAL] belgisi bor
#
# ═══════════════════════════════════════════════════════════════════════════


# ── DJANGO CORE [REQUIRED] ──────────────────────────────────────────────────
# SECRET_KEY — 50+ belgili tasodifiy string. Sirib chiqsa, JWT signature
# bekor bo'ladi → barcha foydalanuvchi qaytadan kirishi kerak.
#
# Yangi kalit generatsiya:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=<TODO_GENERATE_NEW_KEY>

# Production'da SHART: False (DEBUG=True bilan deploy = xavfsizlik buzilishi)
DJANGO_DEBUG=False

# Vergul bilan ajratilgan domenlar. Yulduzcha (*) — XAVFLI, ishlatilmasin.
DJANGO_ALLOWED_HOSTS=<TODO_DOMAIN>.com,www.<TODO_DOMAIN>.com,<TODO_RENDER>.onrender.com


# ── ADMIN URL XAVFSIZLIK [RECOMMENDED] ──────────────────────────────────────
# Default /admin/ — brute-force va skanerlar uchun nishon.
# Tasodifiy slug — kim biladigan har kim emas, faqat siz.
#
# Generatsiya:
#   python -c "import secrets; print(secrets.token_urlsafe(8))"
DJANGO_ADMIN_URL=<TODO_RANDOM_8_CHARS>


# ── DATABASE [REQUIRED] ─────────────────────────────────────────────────────
# Render PostgreSQL: Dashboard → PostgreSQL service → "Internal Connection URL"
# Format: postgres://user:password@host:port/dbname
DATABASE_URL=<TODO_FROM_RENDER_DASHBOARD>


# ── REDIS [REQUIRED IN PRODUCTION] ──────────────────────────────────────────
# Production'da MAJBURIY — multi-worker OTP va rate-limit'lar uchun.
# Yo'q bo'lsa Django ishga tushmaydi (settings.py xato qaytaradi).
#
# Render Redis: Dashboard → Redis service → Internal URL
# Upstash (bepul TLS): rediss://default:TOKEN@HOST.upstash.io:PORT
REDIS_URL=<TODO_FROM_RENDER_OR_UPSTASH>


# ── CORS [REQUIRED] ─────────────────────────────────────────────────────────
# Faqat sizning frontend domeningiz. Yulduzcha XAVFLI.
# Vercel/Netlify domeni bo'lsa: https://your-app.vercel.app ham qo'shing.
CORS_ALLOWED_ORIGINS=https://<TODO_DOMAIN>.com,https://www.<TODO_DOMAIN>.com


# ── HTTPS [REQUIRED] ────────────────────────────────────────────────────────
# Render avtomat HTTPS beradi. True qoldiring.
SECURE_SSL_REDIRECT=True


# ── CDN — Cloudinary [REQUIRED for CDN_PROVIDER=cloudinary] ─────────────────
# Production'da rasm'lar uchun. Bepul reja: 25 GB.
#   Dashboard: https://console.cloudinary.com → Settings → API Keys
CDN_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=<TODO_FROM_CLOUDINARY>
CLOUDINARY_API_KEY=<TODO_FROM_CLOUDINARY>
CLOUDINARY_API_SECRET=<TODO_FROM_CLOUDINARY>


# ── BACKBLAZE B2 — DB BACKUP [REQUIRED] ─────────────────────────────────────
# Phase 0.3 — kunlik DB backup. Bucket ALOHIDA, media bucket'dan farqli.
#
# Sozlash: B2 → Buckets → "bozor-backups" yarating
#   • Files: PRIVATE (muhim!)
#   • Encryption: SSE-B2
#   • App Key: faqat shu bucket'ga ruxsat
B2_KEY_ID=<TODO_FROM_B2>
B2_APPLICATION_KEY=<TODO_FROM_B2>
B2_BUCKET_BACKUPS=bozor-backups
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
BACKUP_RETENTION_DAYS=30


# ── ESKIZ SMS [REQUIRED] ────────────────────────────────────────────────────
# OTP login va buyurtma SMS uchun. Bepul SMS yo'q, har biri ~50 UZS.
#   https://my.eskiz.uz → API kabineti
ESKIZ_EMAIL=<TODO_YOUR_ESKIZ_EMAIL>
ESKIZ_PASSWORD=<TODO_YOUR_ESKIZ_PASSWORD>
ESKIZ_SENDER=4546

# Balans nazorati (Phase 0.4). Threshold'larni biznes hajmiga moslang.
ESKIZ_BALANCE_WARNING_THRESHOLD=50000
ESKIZ_BALANCE_CRITICAL_THRESHOLD=10000
ESKIZ_PRICE_PER_SMS=50


# ── SENTRY — Xato kuzatish [RECOMMENDED] ────────────────────────────────────
# Production'da xato'lar real vaqtda dashboard'ga keladi.
#   https://sentry.io → New Project → Django → DSN
SENTRY_DSN=<TODO_FROM_SENTRY>

# CI/CD pipeline'da:
#   GIT_COMMIT_SHA=$(git rev-parse HEAD)
# Release tracking uchun (qaysi commit qaysi xato keltirdi)
GIT_COMMIT_SHA=


# ── TELEGRAM — Admin alert kanali [REQUIRED] ────────────────────────────────
# Phase 0.5 — barcha alert'lar (Sentry, UptimeRobot, balans, ...) shu yerga.
#
# Sozlash:
#   1. @BotFather → /newbot → token
#   2. Bot bilan /start
#   3. https://api.telegram.org/bot<TOKEN>/getUpdates → chat.id
TELEGRAM_BOT_TOKEN=<TODO_FROM_BOTFATHER>
TELEGRAM_ADMIN_CHAT_ID=<TODO_FROM_GETUPDATES>


# ── BACKUP SUPER_ADMIN [REQUIRED] ───────────────────────────────────────────
# Phase 0.7 — lockout recovery telefoni.
# +998 94 112 67 77 default. Yaratish: python manage.py create_backup_superuser
BACKUP_SUPERUSER_PHONE=+998941126777


# ── API HUJJATLARI [OPTIONAL] ───────────────────────────────────────────────
# Production'da Swagger'ni yopish tavsiya etiladi (xavfsizlik orqali yashirish).
# Beta test davri uchun True qiling.
ENABLE_API_DOCS=False


# ═══════════════════════════════════════════════════════════════════════════
#  TASDIQLASH
# ═══════════════════════════════════════════════════════════════════════════
#
# Yuqorida hamma "<TODO>" qiymatlari to'ldirilgandan keyin:
#
#   cd backend && source venv/bin/activate
#   python manage.py check_deployment
#
# Natija:
#   ✅ OK:       12+ ta tekshiruv
#   ⚠️  WARNING:  0
#   ❌ ERROR:    0
#
# Agar error bor — to'ldirilmagan env'ni topib to'ldiring.
# Agar warning bor — tavsiyalar (kelajakda qilish mumkin).
#
# ═══════════════════════════════════════════════════════════════════════════
